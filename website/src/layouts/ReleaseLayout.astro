---
import type { CollectionEntry } from "astro:content";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SiteLayout from "./SiteLayout.astro";

interface Props {
  release: CollectionEntry<"changelog">;
}

const { release } = Astro.props;
const formattedDate = release.data.date.toLocaleDateString("en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<SiteLayout title={release.data.title} description={release.data.description}>
  <a class="skip-link" href="#release-content">Skip to release notes</a>
  <Header />
  <main id="release-content">
    <header class="release-heading">
      <a href="/changelog/">Changelog</a>
      <p>
        {release.data.version} · <time datetime={release.data.date.toISOString()}
          >{formattedDate}</time
        >
      </p>
      <h1>{release.data.title}</h1>
      <p class="description">{release.data.description}</p>
    </header>
    <article class="release-body"><slot /></article>
    <nav class="release-nav" aria-label="Release navigation">
      <a href="/changelog/">← All releases</a>
      <a href={`https://github.com/kristyancarvalho/argo/releases/tag/${release.data.version}`}
        >GitHub release ↗</a
      >
    </nav>
  </main>
  <Footer />
</SiteLayout>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 1rem;
    left: 1rem;
    padding: 0.7rem 1rem;
    color: var(--argo-blue-950);
    background: var(--argo-text);
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  main {
    min-height: 70vh;
  }
  .release-heading {
    padding: clamp(4rem, 9vw, 8rem) var(--argo-section-gutter) clamp(3rem, 7vw, 6rem);
    border-bottom: 1px solid var(--argo-border);
    background:
      radial-gradient(circle at 80% 10%, var(--argo-blue-600), transparent 30%),
      var(--argo-blue-950);
  }
  .release-heading > a,
  .release-heading > p:first-of-type {
    color: var(--argo-blue-400);
    font-family: var(--argo-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  h1 {
    max-width: 13ch;
    margin: 1.25rem 0;
    font-family: var(--argo-font-display);
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.88;
  }
  .description {
    max-width: 45rem;
    color: var(--argo-blue-100);
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.65;
  }
  .release-body {
    width: min(calc(100% - 2.5rem), 52rem);
    margin: 0 auto;
    padding-block: clamp(3rem, 7vw, 6rem);
    color: var(--argo-text-muted);
    font-size: 1.03rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  .release-body :global(h2) {
    margin: 3rem 0 1rem;
    color: var(--argo-text);
    font-family: var(--argo-font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.03em;
  }
  .release-body :global(code) {
    padding: 0.15em 0.35em;
    border-radius: 0.25rem;
    color: var(--argo-blue-200);
    background: var(--argo-blue-950);
  }
  .release-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .release-body :global(th),
  .release-body :global(td) {
    padding: 0.6rem;
    border-bottom: 1px solid var(--argo-border);
  }
  .release-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    width: min(calc(100% - 2.5rem), 52rem);
    margin: 0 auto;
    padding: 2rem 0 4rem;
    border-top: 1px solid var(--argo-border);
  }
  .release-nav a {
    color: var(--argo-blue-400);
    font-weight: 700;
    text-decoration: none;
  }
  @media (max-width: 40rem) {
    .release-nav {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
