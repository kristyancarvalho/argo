---
type IconName =
  | "activity"
  | "arrow-right"
  | "book"
  | "database"
  | "github"
  | "history"
  | "menu"
  | "network"
  | "route"
  | "server"
  | "shield"
  | "terminal";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === "activity" && (
      <>
        <path d="M3 12h4l2.5-7 5 14 2.5-7h4" />
      </>
    )
  }
  {
    name === "arrow-right" && (
      <>
        <>
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </>
      </>
    )
  }
  {
    name === "book" && (
      <>
        <>
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" />
        </>
      </>
    )
  }
  {
    name === "database" && (
      <>
        <>
          <ellipse cx="12" cy="5" rx="8" ry="3" />
          <path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5" />
          <path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" />
        </>
      </>
    )
  }
  {
    name === "github" && (
      <>
        <>
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7.4A5.8 5.8 0 0 0 19.3 3 5.4 5.4 0 0 0 19.1 0S17.9-.4 15 1.5a13.4 13.4 0 0 0-6 0C6.1-.4 4.9 0 4.9 0A5.4 5.4 0 0 0 4.7 3a5.8 5.8 0 0 0-1.5 4.1c0 5.8 3.5 7 6.8 7.4A4.8 4.8 0 0 0 9 18v4" />
          <path d="M9 19c-3 .9-3-1.5-4-2" />
        </>
      </>
    )
  }
  {
    name === "history" && (
      <>
        <>
          <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
          <path d="M3 3v5h5" />
          <path d="M12 7v5l3 2" />
        </>
      </>
    )
  }
  {
    name === "menu" && (
      <>
        <path d="M4 7h16M4 12h16M4 17h16" />
      </>
    )
  }
  {
    name === "network" && (
      <>
        <>
          <rect x="9" y="2" width="6" height="6" rx="1" />
          <rect x="2" y="16" width="6" height="6" rx="1" />
          <rect x="16" y="16" width="6" height="6" rx="1" />
          <path d="M12 8v4M5 16v-4h14v4" />
        </>
      </>
    )
  }
  {
    name === "route" && (
      <>
        <>
          <circle cx="6" cy="19" r="3" />
          <circle cx="18" cy="5" r="3" />
          <path d="M8.5 17.5 16 7M6 16V8a3 3 0 0 1 3-3h6" />
        </>
      </>
    )
  }
  {
    name === "server" && (
      <>
        <>
          <rect x="3" y="4" width="18" height="6" rx="2" />
          <rect x="3" y="14" width="18" height="6" rx="2" />
          <path d="M7 7h.01M7 17h.01" />
        </>
      </>
    )
  }
  {
    name === "shield" && (
      <>
        <>
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
          <path d="m9 12 2 2 4-4" />
        </>
      </>
    )
  }
  {
    name === "terminal" && (
      <>
        <>
          <rect x="2" y="3" width="20" height="18" rx="2" />
          <path d="m7 8 4 4-4 4M13 16h4" />
        </>
      </>
    )
  }
</svg>
